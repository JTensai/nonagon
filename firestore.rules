rules_version = '2';

// One document per goal board: /boards/{boardId}
// Owners can do anything with their boards. Anyone can read a board whose
// owner turned on link sharing (public == true). Email/password accounts
// must verify their email before they can save.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function verified() {
      return request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider != 'password';
    }

    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }

    function validBoard(d) {
      return d.keys().hasAll(['ownerId', 'title', 'rootId', 'nodes', 'public', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() <= 300
        && d.rootId is string
        && d.nodes is map
        && d.public is bool
        && d.createdAt is number && d.updatedAt is number;
    }

    match /boards/{boardId} {
      allow read: if resource.data.public == true || owns(resource.data);
      allow create: if owns(request.resource.data) && verified() && validBoard(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data) && verified()
        && validBoard(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
