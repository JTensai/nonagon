rules_version = '2';

// One document per goal board: /boards/{boardId}
// Owners can do anything with their boards. Anyone can read a board whose
// owner turned on link sharing (public == true). Email/password accounts
// must verify their email before they can save.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function verified() {
      return request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider != 'password';
    }

    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }

    function validBoard(d) {
      return d.keys().hasAll(['ownerId', 'title', 'rootId', 'nodes', 'public', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() <= 300
        && d.rootId is string
        && d.nodes is map
        && d.public is bool
        && d.createdAt is number && d.updatedAt is number;
    }

    match /boards/{boardId} {
      allow read: if resource.data.public == true || owns(resource.data);
      allow create: if owns(request.resource.data) && verified() && validBoard(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data) && verified()
        && validBoard(request.resource.data);
      allow delete: if owns(resource.data);
    }

    // "Request a change" submissions: /feedback/{id}
    // Signed-in, verified users can add one. Anyone can read them, because a
    // GitHub Action reads them with the public API key and posts each one as a
    // public GitHub issue. No names or emails are stored.
    function validFeedback(d) {
      return d.keys().hasOnly(['text', 'kind', 'screen', 'createdAt'])
        && d.keys().hasAll(['text', 'kind', 'createdAt'])
        && d.text is string && d.text.size() >= 10 && d.text.size() <= 2000
        && d.kind in ['idea', 'bug']
        && (!('screen' in d) || (d.screen is string && d.screen.size() <= 40))
        && d.createdAt == request.time;
    }

    match /feedback/{id} {
      allow read: if true;
      allow create: if signedIn() && verified() && validFeedback(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
